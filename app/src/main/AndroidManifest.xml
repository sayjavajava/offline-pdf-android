<?xml version="1.0" encoding="utf-8"?>
<!--
    No <uses-permission> for INTERNET, anywhere in this file, ever — see
    ANDROID_IMPLEMENTATION_PLAN.md §3 (tool-docs repo). Its absence is what
    makes "fully offline" a guarantee the OS enforces at the socket layer,
    not just an intention. CI's offline-gate step greps the merged
    manifest for this exact string and fails the build if it appears.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".OffGridPdfApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.OffGridPDF"
        android:supportsRtl="true">

        <!--
            configChanges: Compose already handles these itself — it reads
            them through LocalConfiguration, so the two things in this app
            that depend on configuration (the tablet two-pane split in
            OffGridNavHost, keyed on screenWidthDp, and isSystemInDarkTheme
            in Theme.kt) recompose correctly without the Activity being torn
            down and rebuilt.

            Without this, every rotation destroyed and recreated the Activity,
            which threw away the picked file, everything typed into a tool's
            options, and any operation still running. Handling the change
            keeps all of it, including work in flight — something saved
            instance state could not do, since the coroutine doing the work
            dies with the old Activity either way.

            locale is deliberately absent: a locale change should recreate, so
            resources re-resolve properly.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|layoutDirection"
            android:theme="@style/Theme.OffGridPDF">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                "Open with OffGridPDF" from a file manager / another app's
                file picker. android:mimeType only (no <data android:scheme>)
                so this matches any content://, file://, or http(s):// PDF a
                launcher hands us the same way — the app never fetches a URL
                itself, it just reads whatever stream Android already
                resolved for it, same guarantee as every SAF-picked file.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- "Share" a PDF into OffGridPDF from Gmail, Files, Drive, etc. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!--
            Internal-only: mints content:// Uris for tool-chaining's cache
            file (files/ChainFile.kt) so one tool's result can be handed to
            another without a system file-picker round trip. Never
            exported — nothing outside this app ever addresses it.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
